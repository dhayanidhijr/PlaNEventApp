@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject PlaNEvent.Client.Services.DisplaySettingsService DisplaySettings
@inject PlaNEvent.Client.Services.TimeZoneState TimeZoneState
@implements IDisposable

<div class="app-scale-root">
    <div class="app-shell">
        <aside class="app-sidebar">
            <NavMenu />
        </aside>

        <main class="app-main">
            <header class="app-topbar px-4">
                <div class="app-topbar-left">
                    <span>@CurrentTime.ToString("MMMM dd, yyyy")</span>
                    <span>@CurrentTime.ToString("hh:mm:ss tt")</span>
                    <span>@CurrentTimeZoneDisplay</span>
                </div>
                <div class="app-topbar-right">
                    <select class="form-select form-select-sm app-timezone-select" value="@selectedTimeZoneId" @onchange="OnTimeZoneChanged">
                        @foreach (var timeZone in TimeZoneOptions)
                        {
                            <option value="@timeZone.Id">@timeZone.Label</option>
                        }
                    </select>
                    <select class="form-select form-select-sm app-theme-select" value="@DisplaySettings.Theme" @onchange="OnThemeChanged">
                        <option value="default">Default</option>
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                        <option value="grayscale-light">Grayscale Light</option>
                        <option value="grayscale-dark">Grayscale Dark</option>
                        <option value="colour">Colour</option>
                    </select>
                    <select class="form-select form-select-sm app-scale-select" value="@DisplaySettings.ScalePercent" @onchange="OnScaleChanged">
                        @foreach (var scaleOption in ScaleOptions)
                        {
                            <option value="@scaleOption">@($"{scaleOption}%")</option>
                        }
                    </select>
                    <AuthorizeView>
                        <Authorized>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="SignOut">Sign Out</button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </header>

            <article class="app-content px-4">
                @Body
            </article>
        </main>
    </div>

    <AgentChatOverlay />
</div>

@code {
    private string selectedTimeZoneId = "America/New_York";
    private PeriodicTimer? clockTimer;
    private CancellationTokenSource? clockCancellation;

    private static readonly int[] ScaleOptions = [75, 80, 85, 90, 95, 100, 105, 110, 115, 120, 125, 130, 135, 140, 145, 150, 155, 160, 165, 170, 175, 180, 185, 190, 195, 200];

    private static readonly (string Id, string Label)[] TimeZoneOptions =
    [
        ("America/New_York", "New York"),
        ("Europe/London", "London"),
        ("Asia/Kolkata", "Chennai")
    ];

    private DateTimeOffset CurrentTime => TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, SelectedTimeZone);

    private TimeZoneInfo SelectedTimeZone => ResolveTimeZone(selectedTimeZoneId);

    private string CurrentTimeZoneDisplay
    {
        get
        {
            var current = CurrentTime;
            var label = TimeZoneOptions.FirstOrDefault(option => option.Id == selectedTimeZoneId).Label;
            return $"{label} (UTC{current:zzz})";
        }
    }

    protected override void OnInitialized()
    {
        selectedTimeZoneId = TimeZoneState.SelectedTimeZoneId;
        DisplaySettings.Changed += OnDisplaySettingsChanged;
        TimeZoneState.Changed += OnTimeZoneStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await DisplaySettings.EnsureInitializedAsync();

        clockCancellation = new CancellationTokenSource();
        clockTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunClockAsync(clockCancellation.Token);
    }

    private async Task SignOut()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/auth/login", true);
    }

    private async Task OnThemeChanged(ChangeEventArgs args)
    {
        await DisplaySettings.SetThemeAsync(args.Value?.ToString() ?? "default");
    }

    private async Task OnScaleChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var scalePercent))
        {
            await DisplaySettings.SetScalePercentAsync(scalePercent);
        }
    }

    private Task OnTimeZoneChanged(ChangeEventArgs args)
    {
        selectedTimeZoneId = args.Value?.ToString() ?? "America/New_York";
        TimeZoneState.SetSelectedTimeZone(selectedTimeZoneId);
        return InvokeAsync(StateHasChanged);
    }

    private async Task RunClockAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (clockTimer is not null && await clockTimer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnDisplaySettingsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnTimeZoneStateChanged()
    {
        selectedTimeZoneId = TimeZoneState.SelectedTimeZoneId;
        _ = InvokeAsync(StateHasChanged);
    }

    private static TimeZoneInfo ResolveTimeZone(string id)
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById(id);
        }
        catch
        {
            return TimeZoneInfo.Local;
        }
    }

    public void Dispose()
    {
        DisplaySettings.Changed -= OnDisplaySettingsChanged;
        TimeZoneState.Changed -= OnTimeZoneStateChanged;
        clockCancellation?.Cancel();
        clockTimer?.Dispose();
        clockCancellation?.Dispose();
    }
}
