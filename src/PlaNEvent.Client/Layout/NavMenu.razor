@inject NavigationManager NavigationManager

<div class="brand-block" title="PlaNEvent">
    <img class="brand-logo" src="images/planevent-logo.png" alt="PlaNEvent" />
    <div class="brand-text">PlaNEvent</div>
</div>

<div class="nav-scrollable">
    <AuthorizeView>
        <Authorized Context="authState">
            <nav class="side-nav">
                <NavLink class="side-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink class="side-link" href="calendar">Calendar</NavLink>
                <NavLink class="side-link" href="occurrences">Occurrence</NavLink>
                <NavLink class="side-link" href="groups">Group Management</NavLink>
                <NavLink class="side-link" href="staff">Staff</NavLink>
                <NavLink class="side-link" href="customers">Customers</NavLink>
                <NavLink class="side-link" href="bookings">Booking Management</NavLink>
                <NavLink class="side-link" href="profile">Account</NavLink>
                @if (authState.User.IsInRole("Admin"))
                {
                    <NavLink class="side-link" href="admin/users">Admin Panel</NavLink>
                }
                <button class="side-link side-btn" @onclick="Logout">Logout</button>
            </nav>
        </Authorized>
        <NotAuthorized>
            <nav class="side-nav">
                <NavLink class="side-link" href="auth/login">Login</NavLink>
                <NavLink class="side-link" href="auth/register">Register</NavLink>
            </nav>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/auth/login", true);
    }
}
