@page "/sage-goal-overrides"
@attribute [Authorize]
@inject ApiClient ApiClient

<div class="module-header">
    <div>
        <h1 class="page-title">Goal Override Settings</h1>
        <p class="subtitle">Manually override monthly targets and feature-level targets when you need Sage to operate against an adjusted plan.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(status))
{
    <div class="alert @(saveSucceeded ? "alert-success" : "alert-info")">@status</div>
}

@if (model is null)
{
    <div class="card">
        <div class="card-body">
            <p class="mb-0">Loading goal override settings...</p>
        </div>
    </div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-4">
                <div class="col-lg-6">
                    <label class="form-label d-flex align-items-center gap-2">
                        <InputCheckbox @bind-Value="model.OverrideExpectedMonthlyBookingCount" />
                        <span>Expected Monthly Booking Count</span>
                    </label>
                    <input class="form-control readonly-field"
                           type="number"
                           value="@model.ExpectedMonthlyBookingCount"
                           readonly="@(!model.OverrideExpectedMonthlyBookingCount)"
                           @oninput="args => UpdateMonthlyBookingCount(args.Value?.ToString())" />
                </div>
                <div class="col-lg-6">
                    <label class="form-label d-flex align-items-center gap-2">
                        <InputCheckbox @bind-Value="model.OverrideExpectedMonthlySalesAmount" />
                        <span>Expected Monthly Sales Amount</span>
                    </label>
                    <input class="form-control readonly-field"
                           type="number"
                           step="0.01"
                           value="@model.ExpectedMonthlySalesAmount"
                           readonly="@(!model.OverrideExpectedMonthlySalesAmount)"
                           @oninput="args => UpdateMonthlySalesAmount(args.Value?.ToString())" />
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="mb-3">
                <h4 class="mb-0">Feature Targets</h4>
                <p class="text-muted mb-0">These rows mirror Sage Goal Settings. Enable override on the rows you want to persist separately here.</p>
            </div>

            @if (model.Features.Count == 0)
            {
                <p class="text-muted mb-3">No feature targets are available in Sage Goal Settings yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th style="width: 7rem;">Override</th>
                                <th>Feature</th>
                                <th>Expected Bookings</th>
                                <th>Expected Sales</th>
                                <th>Target Share %</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < model.Features.Count; index++)
                            {
                                var rowIndex = index;
                                var feature = model.Features[rowIndex];
                                <tr @key="feature">
                                    <td>
                                        <InputCheckbox @bind-Value="feature.IsOverrideEnabled" />
                                    </td>
                                    <td>
                                        <input class="form-control readonly-field"
                                               value="@feature.Name"
                                               readonly />
                                    </td>
                                    <td>
                                        <input class="form-control readonly-field"
                                               type="number"
                                               readonly="@(!feature.IsOverrideEnabled)"
                                               value="@feature.ExpectedMonthlyBookingCount"
                                               @oninput="args => UpdateFeatureBookingCount(rowIndex, args.Value?.ToString())" />
                                    </td>
                                    <td>
                                        <input class="form-control readonly-field"
                                               type="number"
                                               step="0.01"
                                               readonly="@(!feature.IsOverrideEnabled)"
                                               value="@feature.ExpectedMonthlySalesAmount"
                                               @oninput="args => UpdateFeatureSalesAmount(rowIndex, args.Value?.ToString())" />
                                    </td>
                                    <td>
                                        <input class="form-control readonly-field"
                                               type="number"
                                               step="0.01"
                                               readonly="@(!feature.IsOverrideEnabled)"
                                               value="@feature.TargetSharePercent"
                                               @oninput="args => UpdateFeatureTargetShare(rowIndex, args.Value?.ToString())" />
                                    </td>
                                    <td></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="text-muted">
                    Total enabled target share allocation: @TotalEnabledTargetShare().ToString("0.##")%
                </div>
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">Save Override Goal Settings</button>
            </div>
        </div>
    </div>
}

@code {
    private SageGoalOverrideSettingsDto? model;
    private string? status;
    private bool saveSucceeded;

    protected override async Task OnInitializedAsync()
    {
        model = await ApiClient.SageGoalOverrideSettingsAsync() ?? new SageGoalOverrideSettingsDto();
    }

    private void UpdateMonthlyBookingCount(string? value)
    {
        if (model is null)
        {
            return;
        }

        model.ExpectedMonthlyBookingCount = int.TryParse(value, out var parsed)
            ? Math.Max(0, parsed)
            : 0;
    }

    private void UpdateMonthlySalesAmount(string? value)
    {
        if (model is null)
        {
            return;
        }

        model.ExpectedMonthlySalesAmount = decimal.TryParse(value, out var parsed)
            ? Math.Max(0, parsed)
            : 0;
    }

    private void UpdateFeatureBookingCount(int index, string? value)
    {
        if (model is null || index < 0 || index >= model.Features.Count)
        {
            return;
        }

        model.Features[index].ExpectedMonthlyBookingCount = int.TryParse(value, out var parsed)
            ? Math.Max(0, parsed)
            : 0;
    }

    private void UpdateFeatureSalesAmount(int index, string? value)
    {
        if (model is null || index < 0 || index >= model.Features.Count)
        {
            return;
        }

        model.Features[index].ExpectedMonthlySalesAmount = decimal.TryParse(value, out var parsed)
            ? Math.Max(0, parsed)
            : 0;
    }

    private void UpdateFeatureTargetShare(int index, string? value)
    {
        if (model is null || index < 0 || index >= model.Features.Count)
        {
            return;
        }

        model.Features[index].TargetSharePercent = decimal.TryParse(value, out var parsed)
            ? Math.Clamp(parsed, 0, 100)
            : 0;
    }

    private async Task SaveAsync()
    {
        if (model is null)
        {
            return;
        }

        model.Features = model.Features
            .Where(x => !string.IsNullOrWhiteSpace(x.Name))
            .Select((x, index) =>
            {
                x.SortOrder = index;
                return x;
            })
            .ToList();

        var saved = await ApiClient.SaveSageGoalOverrideSettingsAsync(model);
        if (saved is null)
        {
            saveSucceeded = false;
            status = "Goal override settings could not be saved.";
            return;
        }

        model = saved;
        saveSucceeded = true;
        status = "Goal override settings saved successfully.";
    }

    private decimal TotalEnabledTargetShare()
        => model?.Features.Where(x => x.IsOverrideEnabled).Sum(x => x.TargetSharePercent) ?? 0;
}
