@page "/showcase/{OwnerSlug}"
@layout PublicLayout
@inject ApiClient ApiClient
@inject BookingService BookingService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<div class="showcase-page">
    <section class="showcase-hero">
        <div class="showcase-hero-content">
            <div class="showcase-kicker">PlaNEvent Booking Showcase</div>
            <h1>@(showcase?.CurrentPageName ?? "Showcase")</h1>
            <p class="showcase-lead">Browse categories, explore offerings, and complete booking without the internal admin shell.</p>

            @if (showcase?.Breadcrumbs.Count > 0)
            {
                <div class="showcase-breadcrumbs">
                    @foreach (var crumb in showcase.Breadcrumbs)
                    {
                        <span>@crumb</span>
                    }
                </div>
            }
        </div>

        <div class="showcase-search-panel">
            <label class="showcase-search-label" for="showcase-search">Search the showcase</label>
            <div class="showcase-search-row">
                <input id="showcase-search" class="form-control showcase-search-input" placeholder="Search categories or offerings" @bind="searchTerm" @bind:event="oninput" />
                <button class="btn showcase-search-btn" @onclick="ApplySearch">Search</button>
            </div>
            <div class="showcase-search-note">Use search, tabs, and carousel rows to move through the booking experience.</div>
        </div>
    </section>

    @if (showcase is null)
    {
        <section class="showcase-loading">
            <p>Loading showcase...</p>
        </section>
    }
    else
    {
        <nav class="showcase-tabs" aria-label="Showcase pages">
            @foreach (var tab in showcase.Tabs)
            {
                <button class="showcase-tab @(tab.IsActive ? "active" : string.Empty)" @onclick="() => OpenPage(tab.Slug)">@tab.Name</button>
            }
        </nav>

        @if (showcase.BookingCalendar is not null)
        {
            <section class="booking-shell">
                <aside class="booking-sidebar">
                    <div class="booking-sidebar-panel">
                        <div class="booking-sidebar-title">Choose a schedule</div>
                        @foreach (var occurrence in showcase.OccurrenceChoices)
                        {
                            <button class="booking-choice @(ruleGroupId == occurrence.RuleGroupId ? "active" : string.Empty)" @onclick="() => SelectOccurrence(occurrence.RuleGroupId)">
                                <span class="booking-choice-dot" style="background:@occurrence.Color"></span>
                                <span class="booking-choice-copy">
                                    <strong>@occurrence.Name</strong>
                                    <small>@FormatDateRange(occurrence.StartDateUtc, occurrence.EndDateUtc)</small>
                                </span>
                            </button>
                        }
                    </div>
                </aside>

                <section class="booking-calendar-panel">
                    <div class="booking-calendar-header">
                        <div>
                            <h2>@showcase.BookingCalendar.Title</h2>
                            <p>@showcase.BookingCalendar.SelectedOccurrenceName</p>
                        </div>
                        <div class="booking-view-switch">
                            @foreach (var option in new[] { "list", "month" })
                            {
                                <button class="@(calendarView == option ? "active" : string.Empty)" @onclick='() => calendarView = option'>@option</button>
                            }
                        </div>
                    </div>

                    @if (calendarView == "list")
                    {
                        <div class="booking-list">
                            @foreach (var occurrence in showcase.BookingCalendar.Occurrences)
                            {
                                <article class="booking-card">
                                    <div class="booking-card-head">
                                        <div>
                                            <h3>@occurrence.Title</h3>
                                            <p>@occurrence.RuleGroupName</p>
                                        </div>
                                        <span class="booking-choice-dot" style="background:@occurrence.Color"></span>
                                    </div>

                                    <div class="booking-slot-list">
                                        @foreach (var slot in occurrence.Slots)
                                        {
                                            <div class="booking-slot">
                                                <div>
                                                    <strong>@slot.StartUtc.ToLocalTime().ToString("MMM dd, yyyy")</strong>
                                                    <span>@slot.StartUtc.ToLocalTime().ToString("hh:mm tt") - @slot.EndUtc.ToLocalTime().ToString("hh:mm tt")</span>
                                                </div>
                                                <button class="btn btn-primary" @onclick="() => Book(occurrence.Id, slot.Id)">Book</button>
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="showcase-month-shell">
                            <div class="week-head">
                                <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
                            </div>
                            <div class="month-grid">
                                @foreach (var day in DaysInMonth())
                                {
                                    <div class="day-cell">
                                        <div class="day-num">@day.Day</div>
                                        @foreach (var occurrence in showcase.BookingCalendar.Occurrences.Where(x => x.Slots.Any(s => s.StartUtc.Date == day.Date)).Take(3))
                                        {
                                            <div class="event-chip" style="background:@occurrence.Color">@occurrence.Title</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>
            </section>
        }
        else
        {
            @for (var index = 0; index < showcase.Rows.Count; index++)
            {
                var row = showcase.Rows.ElementAt(index);
                var railId = $"showcase-rail-{index}";

                <section class="showcase-row-section">
                    <div class="showcase-row-header">
                        <div>
                            <h2>@row.Name</h2>
                            <p>@(row.CarouselType == "rail" ? "Swipe through the collection" : "Featured picks from this row")</p>
                        </div>
                        <div class="showcase-row-controls">
                            <button type="button" class="showcase-arrow" @onclick="() => ScrollRailAsync(railId, -1)" aria-label="Previous cards">&#10094;</button>
                            <button type="button" class="showcase-arrow" @onclick="() => ScrollRailAsync(railId, 1)" aria-label="Next cards">&#10095;</button>
                        </div>
                    </div>

                    <div id="@railId" class="showcase-rail @(row.CarouselType == "rail" ? "compact" : string.Empty)">
                        @foreach (var card in row.Cards)
                        {
                            <button type="button" class="showcase-card" @onclick="() => OpenCard(card)">
                                <div class="showcase-card-media" style="@CardBackgroundStyle(card)">
                                    @if (!string.IsNullOrWhiteSpace(card.ImageUrl))
                                    {
                                        <div class="showcase-card-image @(card.Blur ? "blurred" : string.Empty)" style="background-image:url('@card.ImageUrl');"></div>
                                    }
                                    <div class="showcase-card-overlay"></div>
                                    <div class="showcase-card-badge">@(card.CardType == "category" ? "Category" : "Offering")</div>
                                    <div class="showcase-card-copy">
                                        @if (!card.HideTitle)
                                        {
                                            <h3>@card.Title</h3>
                                        }
                                        @if (card.ShowDescription)
                                        {
                                            <p>@card.Description</p>
                                        }
                                    </div>
                                </div>
                            </button>
                        }
                    </div>
                </section>
            }
        }

        @if (!string.IsNullOrWhiteSpace(status))
        {
            <div class="showcase-status">@status</div>
        }
    }
</div>

@code {
    [Parameter] public string OwnerSlug { get; set; } = string.Empty;
    [SupplyParameterFromQuery] public string? pageSlug { get; set; }
    [SupplyParameterFromQuery] public string? sourceType { get; set; }
    [SupplyParameterFromQuery] public int? sourceId { get; set; }
    [SupplyParameterFromQuery] public int? offeringId { get; set; }
    [SupplyParameterFromQuery] public int? ruleGroupId { get; set; }
    [SupplyParameterFromQuery] public string? searchTerm { get; set; }

    private PublicShowcaseDto? showcase;
    private string? status;
    private string calendarView = "list";

    protected override async Task OnParametersSetAsync()
    {
        showcase = await ApiClient.PublicShowcaseAsync(OwnerSlug, pageSlug, sourceType, sourceId, offeringId, ruleGroupId, searchTerm);
    }

    private void OpenPage(string slug)
        => NavigationManager.NavigateTo($"/showcase/{OwnerSlug}?pageSlug={Uri.EscapeDataString(slug)}");

    private void OpenCard(PublicShowcaseCardDto card)
    {
        var query = $"pageSlug={Uri.EscapeDataString(showcase?.CurrentPageSlug ?? string.Empty)}";
        query += card.CardType == "category"
            ? $"&sourceType=category&sourceId={card.SourceId}"
            : $"&offeringId={card.SourceId}";
        NavigationManager.NavigateTo($"/showcase/{OwnerSlug}?{query}");
    }

    private void SelectOccurrence(int? nextRuleGroupId)
    {
        var query = $"pageSlug={Uri.EscapeDataString(showcase?.CurrentPageSlug ?? string.Empty)}&offeringId={offeringId}";
        if (nextRuleGroupId.HasValue)
        {
            query += $"&ruleGroupId={nextRuleGroupId.Value}";
        }

        NavigationManager.NavigateTo($"/showcase/{OwnerSlug}?{query}");
    }

    private void ApplySearch()
    {
        var query = $"pageSlug={Uri.EscapeDataString(showcase?.CurrentPageSlug ?? pageSlug ?? string.Empty)}";
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query += $"&searchTerm={Uri.EscapeDataString(searchTerm)}";
        }

        NavigationManager.NavigateTo($"/showcase/{OwnerSlug}?{query}");
    }

    private async Task Book(int occurrenceId, int slotId)
    {
        var ok = await BookingService.BookAsync(occurrenceId, slotId, "Booked from showcase");
        status = ok ? "Booking placed successfully." : "Booking failed. Sign in as a customer or standard user.";
    }

    private async Task ScrollRailAsync(string railId, int direction)
    {
        try
        {
            await JS.InvokeVoidAsync("showcaseUi.scrollRail", railId, direction);
        }
        catch (JSException)
        {
            // If the helper script is stale or missing in the browser cache, keep the page usable.
        }
    }

    private static string CardBackgroundStyle(PublicShowcaseCardDto card)
        => $"background:linear-gradient(145deg, {card.AccentColor}, #0f172a);";

    private static string FormatDateRange(DateTime? startUtc, DateTime? endUtc)
    {
        if (!startUtc.HasValue && !endUtc.HasValue)
        {
            return "Schedule available";
        }

        if (startUtc.HasValue && endUtc.HasValue)
        {
            return $"{startUtc.Value.ToLocalTime():MMM dd, yyyy} - {endUtc.Value.ToLocalTime():MMM dd, yyyy}";
        }

        return startUtc?.ToLocalTime().ToString("MMM dd, yyyy") ?? endUtc?.ToLocalTime().ToString("MMM dd, yyyy") ?? "Schedule available";
    }

    private IEnumerable<DateTime> DaysInMonth()
    {
        var pivot = DateTime.UtcNow.Date;
        var first = new DateTime(pivot.Year, pivot.Month, 1);
        var start = first.AddDays(-(int)first.DayOfWeek);
        return Enumerable.Range(0, 42).Select(i => start.AddDays(i));
    }
}
