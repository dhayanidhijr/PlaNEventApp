@page "/showcase/{OwnerSlug}"
@layout PublicLayout
@inject ApiClient ApiClient
@inject BookingService BookingService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<div class="showcase-page">
    <section class="showcase-hero">
        <div class="showcase-hero-content">
            <div class="showcase-kicker">PlaNEvent Booking Showcase</div>
            <h1>@(showcase?.CurrentPageName ?? "Showcase")</h1>
            <p class="showcase-lead">Browse categories, explore offerings, and complete booking without the internal admin shell.</p>

            @if (showcase?.Breadcrumbs.Count > 0)
            {
                <div class="showcase-breadcrumbs">
                    @foreach (var crumb in showcase.Breadcrumbs)
                    {
                        <span>@crumb</span>
                    }
                </div>
            }
        </div>

        <div class="showcase-search-panel">
            <label class="showcase-search-label" for="showcase-search">Search the showcase</label>
            <div class="showcase-search-row">
                <input id="showcase-search" class="form-control showcase-search-input" placeholder="Search categories or offerings" @bind="searchTerm" @bind:event="oninput" />
                <button class="btn showcase-search-btn" @onclick="ApplySearch">Search</button>
            </div>
            <div class="showcase-search-note">Use search, tabs, and carousel rows to move through the booking experience.</div>
        </div>
    </section>

    @if (showcase is null)
    {
        <section class="showcase-loading">
            <p>Loading showcase...</p>
        </section>
    }
    else
    {
        <nav class="showcase-tabs" aria-label="Showcase pages">
            @foreach (var tab in showcase.Tabs)
            {
                <button class="showcase-tab @(tab.IsActive ? "active" : string.Empty)" @onclick="() => OpenPage(tab.Slug)">@tab.Name</button>
            }
        </nav>

        @if (showcase.BookingCalendar is not null)
        {
            <section class="booking-shell">
                <aside class="booking-sidebar">
                    <div class="booking-sidebar-panel">
                        <div class="booking-sidebar-title">Choose a schedule</div>
                        @foreach (var occurrence in showcase.OccurrenceChoices)
                        {
                            <button class="booking-choice @(ruleGroupId == occurrence.RuleGroupId ? "active" : string.Empty)" @onclick="() => SelectOccurrence(occurrence.RuleGroupId)">
                                <span class="booking-choice-dot" style="background:@occurrence.Color"></span>
                                <span class="booking-choice-copy">
                                    <strong>@occurrence.Name</strong>
                                    <small>@FormatDateRange(occurrence.StartDateUtc, occurrence.EndDateUtc)</small>
                                </span>
                            </button>
                        }
                    </div>
                </aside>

                <section class="booking-calendar-panel">
                    <div class="booking-calendar-header">
                        <div>
                            <h2>@showcase.BookingCalendar.Title</h2>
                            <p>@showcase.BookingCalendar.SelectedOccurrenceName</p>
                        </div>
                        <div class="booking-view-switch">
                            @foreach (var option in new[] { "month", "list" })
                            {
                                <button class="@(calendarView == option ? "active" : string.Empty)" @onclick='() => calendarView = option'>@option</button>
                            }
                        </div>
                    </div>

                    @if (calendarView == "month")
                    {
                        <div class="showcase-month-nav">
                            <button type="button" class="showcase-month-btn" @onclick="PreviousMonth">&#10094;</button>
                            <div class="showcase-month-label">@monthCursor.ToString("MMMM yyyy")</div>
                            <button type="button" class="showcase-month-btn" @onclick="NextMonth">&#10095;</button>
                        </div>

                        <div class="showcase-month-shell">
                            <div class="week-head">
                                <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
                            </div>
                            <div class="month-grid">
                                @foreach (var day in DaysInMonth())
                                {
                                    var entries = SlotEntriesForDay(day).ToList();
                                    <div class="day-cell @(day.Month != monthCursor.Month ? "muted" : string.Empty)">
                                        <div class="day-num">@day.Day</div>
                                        @foreach (var entry in entries.Take(4))
                                        {
                                            <button type="button" class="event-chip event-chip-button" style="background:@entry.Occurrence.Color" @onclick="() => OpenBookingDialog(entry.Occurrence, entry.Slot)">
                                                <strong>@entry.Slot.StartUtc.ToLocalTime().ToString("hh:mm tt")</strong>
                                                <span>@entry.Occurrence.Title</span>
                                            </button>
                                        }
                                        @if (entries.Count > 4)
                                        {
                                            <div class="event-chip event-chip-more">+@(entries.Count - 4) more</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="booking-list">
                            @foreach (var occurrence in showcase.BookingCalendar.Occurrences)
                            {
                                <article class="booking-card">
                                    <div class="booking-card-head">
                                        <div>
                                            <h3>@occurrence.Title</h3>
                                            <p>@occurrence.RuleGroupName</p>
                                        </div>
                                        <span class="booking-choice-dot" style="background:@occurrence.Color"></span>
                                    </div>

                                    <div class="booking-slot-list">
                                        @foreach (var slot in occurrence.Slots)
                                        {
                                            <div class="booking-slot">
                                                <div>
                                                    <strong>@slot.StartUtc.ToLocalTime().ToString("MMM dd, yyyy")</strong>
                                                    <span>@slot.StartUtc.ToLocalTime().ToString("hh:mm tt") - @slot.EndUtc.ToLocalTime().ToString("hh:mm tt")</span>
                                                    <small>@slot.TotalBookingCount booking(s) already taken</small>
                                                </div>
                                                <button class="btn btn-primary" @onclick="() => OpenBookingDialog(occurrence, slot)">Book</button>
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </section>
            </section>
        }
        else
        {
            @for (var index = 0; index < showcase.Rows.Count; index++)
            {
                var row = showcase.Rows.ElementAt(index);
                var railId = $"showcase-rail-{index}";

                <section class="showcase-row-section">
                    <div class="showcase-row-header">
                        <div>
                            <h2>@row.Name</h2>
                            <p>@(row.CarouselType == "rail" ? "Swipe through the collection" : "Featured picks from this row")</p>
                        </div>
                        <div class="showcase-row-controls">
                            <button type="button" class="showcase-arrow" @onclick="() => ScrollRailAsync(railId, -1)" aria-label="Previous cards">&#10094;</button>
                            <button type="button" class="showcase-arrow" @onclick="() => ScrollRailAsync(railId, 1)" aria-label="Next cards">&#10095;</button>
                        </div>
                    </div>

                    <div id="@railId" class="showcase-rail @(row.CarouselType == "rail" ? "compact" : string.Empty)">
                        @foreach (var card in row.Cards)
                        {
                            <button type="button" class="showcase-card" @onclick="() => OpenCard(card)">
                                <div class="showcase-card-media" style="@CardBackgroundStyle(card)">
                                    @if (!string.IsNullOrWhiteSpace(card.ImageUrl))
                                    {
                                        <div class="showcase-card-image @(card.Blur ? "blurred" : string.Empty)" style="background-image:url('@card.ImageUrl');"></div>
                                    }
                                    <div class="showcase-card-overlay"></div>
                                    <div class="showcase-card-badge">@(card.CardType == "category" ? "Category" : "Offering")</div>
                                    <div class="showcase-card-copy">
                                        @if (!card.HideTitle)
                                        {
                                            <h3>@card.Title</h3>
                                        }
                                        @if (card.ShowDescription)
                                        {
                                            <p>@card.Description</p>
                                        }
                                    </div>
                                </div>
                            </button>
                        }
                    </div>
                </section>
            }
        }

        @if (!string.IsNullOrWhiteSpace(status))
        {
            <div class="showcase-status">@status</div>
        }
    }
</div>

@if (pendingBooking is not null)
{
    <div class="showcase-modal-backdrop" @onclick="CloseBookingDialog">
        <div class="showcase-modal-card" @onclick:stopPropagation="true">
            <button type="button" class="showcase-modal-close" @onclick="CloseBookingDialog">Close</button>
            <div class="showcase-modal-layout">
                <div class="showcase-modal-media" style="@BookingImageStyle(pendingBooking.Occurrence)"></div>
                <div class="showcase-modal-copy">
                    <div class="showcase-modal-kicker">Ready to book</div>
                    <h2>@pendingBooking.Occurrence.Title</h2>
                    <p>@pendingBooking.Occurrence.Description</p>
                    <div class="showcase-detail-grid">
                        <div>
                            <span>Date</span>
                            <strong>@pendingBooking.Slot.StartUtc.ToLocalTime().ToString("MMM dd, yyyy")</strong>
                        </div>
                        <div>
                            <span>Time</span>
                            <strong>@pendingBooking.Slot.StartUtc.ToLocalTime().ToString("hh:mm tt") - @pendingBooking.Slot.EndUtc.ToLocalTime().ToString("hh:mm tt")</strong>
                        </div>
                        <div>
                            <span>Schedule</span>
                            <strong>@(pendingBooking.Occurrence.RuleGroupName ?? "General availability")</strong>
                        </div>
                        <div>
                            <span>Seats Already Taken</span>
                            <strong>@pendingBooking.Slot.TotalBookingCount</strong>
                        </div>
                    </div>
                    <div class="showcase-modal-actions">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseBookingDialog">Cancel</button>
                        <button type="button" class="btn btn-primary" @onclick="ConfirmBookingAsync">Book</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (confirmedBooking is not null)
{
    <div class="showcase-modal-backdrop" @onclick="DismissConfirmation">
        <div class="showcase-modal-card showcase-modal-card-sm" @onclick:stopPropagation="true">
            <button type="button" class="showcase-modal-close" @onclick="DismissConfirmation">Close</button>
            <div class="showcase-modal-kicker">Booking confirmed</div>
            <h2>@confirmedBooking.Title</h2>
            <p>@confirmedBooking.Message</p>
            <div class="showcase-detail-grid">
                <div>
                    <span>Date</span>
                    <strong>@confirmedBooking.StartLocal.ToString("MMM dd, yyyy")</strong>
                </div>
                <div>
                    <span>Time</span>
                    <strong>@confirmedBooking.StartLocal.ToString("hh:mm tt") - @confirmedBooking.EndLocal.ToString("hh:mm tt")</strong>
                </div>
                <div>
                    <span>Schedule</span>
                    <strong>@confirmedBooking.RuleGroupName</strong>
                </div>
                <div>
                    <span>Seats Taken</span>
                    <strong>@confirmedBooking.TotalBookingCount</strong>
                </div>
            </div>
            <div class="showcase-modal-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="PrintConfirmationAsync">Print</button>
                <button type="button" class="btn btn-outline-primary" @onclick="AddToCalendarAsync">Add To Calendar</button>
                <button type="button" class="btn btn-primary" @onclick="DismissConfirmation">Dismiss</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string OwnerSlug { get; set; } = string.Empty;
    [SupplyParameterFromQuery] public string? pageSlug { get; set; }
    [SupplyParameterFromQuery] public string? sourceType { get; set; }
    [SupplyParameterFromQuery] public int? sourceId { get; set; }
    [SupplyParameterFromQuery] public int? offeringId { get; set; }
    [SupplyParameterFromQuery] public int? ruleGroupId { get; set; }
    [SupplyParameterFromQuery] public string? searchTerm { get; set; }

    private PublicShowcaseDto? showcase;
    private string? status;
    private string calendarView = "month";
    private DateTime monthCursor = DateTime.Today;
    private ShowcaseBookingSelection? pendingBooking;
    private ShowcaseBookingConfirmation? confirmedBooking;

    protected override async Task OnParametersSetAsync()
    {
        await LoadShowcaseAsync();
    }

    private async Task LoadShowcaseAsync()
    {
        showcase = await ApiClient.PublicShowcaseAsync(OwnerSlug, pageSlug, sourceType, sourceId, offeringId, ruleGroupId, searchTerm);

        if (showcase?.BookingCalendar?.Occurrences.Count > 0)
        {
            var firstSlot = showcase.BookingCalendar.Occurrences
                .SelectMany(x => x.Slots)
                .OrderBy(x => x.StartUtc)
                .FirstOrDefault();

            if (firstSlot is not null)
            {
                var localStart = firstSlot.StartUtc.ToLocalTime();
                monthCursor = new DateTime(localStart.Year, localStart.Month, 1);
            }
        }
    }

    private void OpenPage(string slug)
        => NavigationManager.NavigateTo($"/showcase/{OwnerSlug}?pageSlug={Uri.EscapeDataString(slug)}");

    private void OpenCard(PublicShowcaseCardDto card)
    {
        var query = $"pageSlug={Uri.EscapeDataString(showcase?.CurrentPageSlug ?? string.Empty)}";
        query += card.CardType == "category"
            ? $"&sourceType=category&sourceId={card.SourceId}"
            : $"&offeringId={card.SourceId}";
        NavigationManager.NavigateTo($"/showcase/{OwnerSlug}?{query}");
    }

    private void SelectOccurrence(int? nextRuleGroupId)
    {
        var query = $"pageSlug={Uri.EscapeDataString(showcase?.CurrentPageSlug ?? string.Empty)}&offeringId={offeringId}";
        if (nextRuleGroupId.HasValue)
        {
            query += $"&ruleGroupId={nextRuleGroupId.Value}";
        }

        NavigationManager.NavigateTo($"/showcase/{OwnerSlug}?{query}");
    }

    private void ApplySearch()
    {
        var query = $"pageSlug={Uri.EscapeDataString(showcase?.CurrentPageSlug ?? pageSlug ?? string.Empty)}";
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query += $"&searchTerm={Uri.EscapeDataString(searchTerm)}";
        }

        NavigationManager.NavigateTo($"/showcase/{OwnerSlug}?{query}");
    }

    private void OpenBookingDialog(OccurrenceDto occurrence, OccurrenceSlotDto slot)
    {
        pendingBooking = new ShowcaseBookingSelection(occurrence, slot);
        status = null;
    }

    private void CloseBookingDialog() => pendingBooking = null;

    private async Task ConfirmBookingAsync()
    {
        if (pendingBooking is null)
        {
            return;
        }

        var selection = pendingBooking;
        var booked = await BookingService.BookAsync(selection.Occurrence.Id, selection.Slot.Id, "Booked from showcase");
        if (booked is null)
        {
            status = "Booking failed. Sign in as a customer or standard user.";
            return;
        }

        confirmedBooking = new ShowcaseBookingConfirmation
        {
            Title = selection.Occurrence.Title,
            RuleGroupName = selection.Occurrence.RuleGroupName ?? "General availability",
            ImageUrl = selection.Occurrence.CoverImageUrl,
            StartLocal = selection.Slot.StartUtc.ToLocalTime(),
            EndLocal = selection.Slot.EndUtc.ToLocalTime(),
            TotalBookingCount = selection.Slot.TotalBookingCount + 1,
            Message = "Your event is booked. You can add it to your calendar, print the confirmation, or dismiss this message."
        };

        pendingBooking = null;
        status = "Booking placed successfully.";
        await LoadShowcaseAsync();
    }

    private async Task AddToCalendarAsync()
    {
        if (confirmedBooking is null)
        {
            return;
        }

        var content = BuildCalendarFile(confirmedBooking);
        var fileName = $"{SanitizeFileName(confirmedBooking.Title)}-{confirmedBooking.StartLocal:yyyyMMddHHmm}.ics";
        await JS.InvokeVoidAsync("showcaseUi.downloadCalendarFile", fileName, content);
    }

    private async Task PrintConfirmationAsync()
    {
        if (confirmedBooking is null)
        {
            return;
        }

        var body = string.Join(string.Empty, new[]
        {
            $"<div class=\"meta\"><strong>Event:</strong> {confirmedBooking.Title}</div>",
            $"<div class=\"meta\"><strong>Date:</strong> {confirmedBooking.StartLocal:MMM dd, yyyy}</div>",
            $"<div class=\"meta\"><strong>Time:</strong> {confirmedBooking.StartLocal:hh:mm tt} - {confirmedBooking.EndLocal:hh:mm tt}</div>",
            $"<div class=\"meta\"><strong>Schedule:</strong> {confirmedBooking.RuleGroupName}</div>",
            $"<div class=\"meta\"><strong>Seats Taken:</strong> {confirmedBooking.TotalBookingCount}</div>"
        });

        await JS.InvokeVoidAsync("showcaseUi.printBookingConfirmation", confirmedBooking.Title, body);
    }

    private void DismissConfirmation() => confirmedBooking = null;

    private async Task ScrollRailAsync(string railId, int direction)
    {
        try
        {
            await JS.InvokeVoidAsync("showcaseUi.scrollRail", railId, direction);
        }
        catch (JSException)
        {
            // If the helper script is stale or missing in the browser cache, keep the page usable.
        }
    }

    private void PreviousMonth() => monthCursor = monthCursor.AddMonths(-1);

    private void NextMonth() => monthCursor = monthCursor.AddMonths(1);

    private IEnumerable<ShowcaseSlotEntry> SlotEntriesForDay(DateTime day)
    {
        if (showcase?.BookingCalendar is null)
        {
            return Enumerable.Empty<ShowcaseSlotEntry>();
        }

        var localDay = day.Date;
        return showcase.BookingCalendar.Occurrences
            .SelectMany(occurrence => occurrence.Slots.Select(slot => new ShowcaseSlotEntry(occurrence, slot)))
            .Where(entry => entry.Slot.StartUtc.ToLocalTime().Date == localDay)
            .OrderBy(entry => entry.Slot.StartUtc);
    }

    private string BookingImageStyle(OccurrenceDto occurrence)
    {
        if (!string.IsNullOrWhiteSpace(occurrence.CoverImageUrl))
        {
            return $"background-image:linear-gradient(180deg, rgba(11,18,34,0.05), rgba(11,18,34,0.4)), url('{occurrence.CoverImageUrl}');";
        }

        return $"background:linear-gradient(145deg, {occurrence.Color}, #0f172a);";
    }

    private static string CardBackgroundStyle(PublicShowcaseCardDto card)
        => $"background:linear-gradient(145deg, {card.AccentColor}, #0f172a);";

    private static string FormatDateRange(DateTime? startUtc, DateTime? endUtc)
    {
        if (!startUtc.HasValue && !endUtc.HasValue)
        {
            return "Schedule available";
        }

        if (startUtc.HasValue && endUtc.HasValue)
        {
            return $"{startUtc.Value.ToLocalTime():MMM dd, yyyy} - {endUtc.Value.ToLocalTime():MMM dd, yyyy}";
        }

        return startUtc?.ToLocalTime().ToString("MMM dd, yyyy") ?? endUtc?.ToLocalTime().ToString("MMM dd, yyyy") ?? "Schedule available";
    }

    private IEnumerable<DateTime> DaysInMonth()
    {
        var first = new DateTime(monthCursor.Year, monthCursor.Month, 1);
        var start = first.AddDays(-(int)first.DayOfWeek);
        return Enumerable.Range(0, 42).Select(i => start.AddDays(i));
    }

    private static string BuildCalendarFile(ShowcaseBookingConfirmation booking)
    {
        var startUtc = booking.StartLocal.ToUniversalTime();
        var endUtc = booking.EndLocal.ToUniversalTime();

        return string.Join("\r\n",
        [
            "BEGIN:VCALENDAR",
            "VERSION:2.0",
            "PRODID:-//PlaNEvent//Booking//EN",
            "BEGIN:VEVENT",
            $"UID:{Guid.NewGuid()}",
            $"DTSTAMP:{DateTime.UtcNow:yyyyMMdd'T'HHmmss'Z'}",
            $"DTSTART:{startUtc:yyyyMMdd'T'HHmmss'Z'}",
            $"DTEND:{endUtc:yyyyMMdd'T'HHmmss'Z'}",
            $"SUMMARY:{EscapeCalendarText(booking.Title)}",
            $"DESCRIPTION:{EscapeCalendarText($"Booked via PlaNEvent. Schedule: {booking.RuleGroupName}")}",
            "END:VEVENT",
            "END:VCALENDAR"
        ]);
    }

    private static string EscapeCalendarText(string value)
        => value.Replace("\\", "\\\\").Replace(";", "\\;").Replace(",", "\\,").Replace("\r", string.Empty).Replace("\n", "\\n");

    private static string SanitizeFileName(string value)
    {
        var invalid = Path.GetInvalidFileNameChars();
        return new string(value.Select(ch => invalid.Contains(ch) ? '-' : ch).ToArray());
    }

    private sealed record ShowcaseSlotEntry(OccurrenceDto Occurrence, OccurrenceSlotDto Slot);

    private sealed record ShowcaseBookingSelection(OccurrenceDto Occurrence, OccurrenceSlotDto Slot);

    private sealed class ShowcaseBookingConfirmation
    {
        public string Title { get; set; } = string.Empty;
        public string RuleGroupName { get; set; } = string.Empty;
        public string ImageUrl { get; set; } = string.Empty;
        public DateTime StartLocal { get; set; }
        public DateTime EndLocal { get; set; }
        public int TotalBookingCount { get; set; }
        public string Message { get; set; } = string.Empty;
    }
}
