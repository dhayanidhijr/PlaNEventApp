@page "/profile"
@attribute [Authorize]
@inject ApiClient ApiClient

<h1>Account Management</h1>

@if (profile is null)
{
    <p>Loading profile...</p>
}
else
{
    <dl>
        <dt>Name</dt>
        <dd>@profile.DisplayName</dd>
        <dt>Email</dt>
        <dd>@profile.Email</dd>
        <dt>Public Showcase URL</dt>
        <dd><a href="@($"/showcase/{profile.PublicSlug}")">@($"/showcase/{profile.PublicSlug}")</a></dd>
        <dt>Roles</dt>
        <dd>@string.Join(", ", profile.Roles)</dd>
    </dl>
}

@code {
    private UserProfileDto? profile;

    protected override async Task OnInitializedAsync()
    {
        profile = await ApiClient.MyProfileAsync();
    }
}
