@page "/occurrences"
@attribute [Authorize]
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager

<div class="module-header">
    <div>
        <h1 class="page-title">Generated Occurrences</h1>
        <p class="subtitle">Occurrences are created from offering rule groups and timeslots. Edit an offering to change what appears here.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(status))
{
    <div class="alert alert-info">@status</div>
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h4 class="mb-0">Occurrence List</h4>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ApplyFilters">Refresh</button>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label>Start Date</label>
                <InputDate class="form-control" @bind-Value="startDate" />
            </div>
            <div class="col-md-4">
                <label>End Date</label>
                <InputDate class="form-control" @bind-Value="endDate" />
            </div>
            <div class="col-md-2">
                <label>Records Per Page</label>
                <select class="form-select" value="@pageSize" @onchange="OnPageSizeChanged">
                    @foreach (var option in PageSizeOptions)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" @onclick="ApplyFilters">Apply Filter</button>
            </div>
        </div>

        @if (!HasRequiredFilter())
        {
            <p class="text-muted mb-0">Choose both a start date and end date to view occurrences.</p>
        }
        else if (occurrences.Count == 0)
        {
            <p class="text-muted mb-0">No generated occurrences found in the selected date range.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Offering</th>
                            <th>Rule Group</th>
                            <th>First Slot</th>
                            <th>Slot Count</th>
                            <th>Total Bookings</th>
                            <th>Published</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var occurrence in occurrences)
                    {
                        var firstSlot = occurrence.Slots.OrderBy(x => x.StartUtc).FirstOrDefault();
                        <tr>
                            <td>@(occurrence.OfferingName ?? occurrence.Title)</td>
                            <td>@(occurrence.RuleGroupName ?? "-")</td>
                            <td>@(firstSlot is null ? "-" : $"{firstSlot.StartUtc.ToLocalTime():MMM dd yyyy hh:mm tt}")</td>
                            <td>@occurrence.Slots.Count</td>
                            <td>@occurrence.TotalBookingCount</td>
                            <td>@(occurrence.IsPublished ? "Yes" : "No")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenBookingDetails(occurrence.Id)">Details</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                <div class="text-muted">
                    Showing @StartRecordNumber() - @EndRecordNumber() of @totalCount occurrence(s)
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPage" disabled="@(currentPage <= 1)">Previous</button>
                    <span>Page @currentPage of @TotalPages()</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(currentPage >= TotalPages())">Next</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private static readonly int[] PageSizeOptions = [10, 20, 50, 100];
    private List<OccurrenceDto> occurrences = new();
    private string? status = "Occurrences are generated from offerings. Manual occurrence creation is disabled.";
    private DateTime? startDate = DateTime.Today.AddDays(-1);
    private DateTime? endDate = DateTime.Today.AddDays(1);
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalCount;

    protected override async Task OnInitializedAsync()
    {
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadPageAsync();
    }

    private async Task PreviousPage()
    {
        if (currentPage <= 1)
        {
            return;
        }

        currentPage--;
        await LoadPageAsync();
    }

    private async Task NextPage()
    {
        if (currentPage >= TotalPages())
        {
            return;
        }

        currentPage++;
        await LoadPageAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
        {
            pageSize = value;
            currentPage = 1;
            await LoadPageAsync();
        }
    }

    private async Task LoadPageAsync()
    {
        if (!HasRequiredFilter())
        {
            occurrences.Clear();
            totalCount = 0;
            status = "A date range is required to view occurrences.";
            return;
        }

        status = "Occurrences are generated from offerings. Manual occurrence creation is disabled.";
        var page = await ApiClient.OccurrencesAsync(ToUtcStart(startDate!.Value), ToUtcEnd(endDate!.Value), currentPage, pageSize);
        occurrences = page?.Items.ToList() ?? new List<OccurrenceDto>();
        totalCount = page?.TotalCount ?? 0;
    }

    private bool HasRequiredFilter() => startDate.HasValue && endDate.HasValue;

    private int TotalPages() => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    private int StartRecordNumber() => totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;

    private int EndRecordNumber() => totalCount == 0 ? 0 : Math.Min(totalCount, currentPage * pageSize);

    private static DateTime ToUtcStart(DateTime localDate)
    {
        var offset = TimeZoneInfo.Local.GetUtcOffset(localDate);
        return new DateTimeOffset(localDate.Year, localDate.Month, localDate.Day, 0, 0, 0, offset).UtcDateTime;
    }

    private static DateTime ToUtcEnd(DateTime localDate)
    {
        var offset = TimeZoneInfo.Local.GetUtcOffset(localDate);
        return new DateTimeOffset(localDate.Year, localDate.Month, localDate.Day, 23, 59, 59, offset).UtcDateTime;
    }

    private void OpenBookingDetails(int occurrenceId)
    {
        if (!HasRequiredFilter())
        {
            return;
        }

        var start = Uri.EscapeDataString(startDate!.Value.ToString("yyyy-MM-dd"));
        var end = Uri.EscapeDataString(endDate!.Value.ToString("yyyy-MM-dd"));
        NavigationManager.NavigateTo($"/bookings?startDate={start}&endDate={end}&occurrenceId={occurrenceId}");
    }
}
