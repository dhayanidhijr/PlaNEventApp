@page "/occurrences"
@attribute [Authorize]
@inject ApiClient ApiClient

<div class="module-header">
    <div>
        <h1 class="page-title">Generated Occurrences</h1>
        <p class="subtitle">Occurrences are created from offering rule groups and timeslots. Edit an offering to change what appears here.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(status))
{
    <div class="alert alert-info">@status</div>
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Occurrence List</h4>
            <button class="btn btn-sm btn-outline-secondary" @onclick="Reload">Refresh</button>
        </div>

        @if (occurrences.Count == 0)
        {
            <p class="text-muted mb-0">No generated occurrences found. Create or update an offering first.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Offering</th>
                            <th>Rule Group</th>
                            <th>First Slot</th>
                            <th>Slot Count</th>
                            <th>Published</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var occurrence in occurrences)
                    {
                        var firstSlot = occurrence.Slots.OrderBy(x => x.StartUtc).FirstOrDefault();
                        <tr>
                            <td>@(occurrence.OfferingName ?? occurrence.Title)</td>
                            <td>@(occurrence.RuleGroupName ?? "-")</td>
                            <td>@(firstSlot is null ? "-" : $"{firstSlot.StartUtc.ToLocalTime():MMM dd yyyy hh:mm tt}")</td>
                            <td>@occurrence.Slots.Count</td>
                            <td>@(occurrence.IsPublished ? "Yes" : "No")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<OccurrenceDto> occurrences = new();
    private string? status = "Occurrences are generated from offerings. Manual occurrence creation is disabled.";

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        occurrences = await ApiClient.OccurrencesAsync();
    }
}
