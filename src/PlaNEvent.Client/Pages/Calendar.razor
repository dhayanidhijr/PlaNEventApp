@page "/calendar"
@attribute [Authorize]
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager

<div class="module-header">
    <div>
        <h1 class="page-title">Calendar Home</h1>
        <p class="subtitle">Tree navigation, calendar views, and showcase entry points.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light" @onclick="OpenCategoryModal">Add Category</button>
        <button class="btn btn-primary" @onclick="OpenOfferingWizard">Add Booking</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(status))
{
    <div class="alert alert-info">@status</div>
}

<div class="calendar-shell">
    <aside class="offerings-panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Categories & Offerings</h3>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ReloadAsync">Refresh</button>
        </div>
        <input class="form-control search-box" placeholder="Search tree" @bind="searchText" @bind:event="oninput" />

        <div class="tree-list mt-3">
            @foreach (var row in VisibleRows())
            {
                <div class="tree-row @(selectedNodeType == row.NodeType && selectedNodeId == row.Id ? "selected" : string.Empty)" style="padding-left:@(8 + row.Level * 18)px">
                    <span class="tree-toggle">@(row.NodeType == "category" ? ">" : ".")</span>
                    <span class="tree-dot" style="background:@row.Color"></span>
                    <button class="tree-label-btn" @onclick="() => SelectNode(row.NodeType, row.Id)">@row.Name</button>
                    <button class="tree-menu-trigger" @onclick="() => EditNode(row.NodeType, row.Id)">Edit</button>
                </div>
            }
        </div>

        <div class="d-grid gap-2 mt-3">
            <button class="btn btn-light" @onclick="OpenCategoryModal">Add Category</button>
            <button class="btn btn-primary" @onclick="OpenOfferingWizard">+ New Offering</button>
            <button class="btn btn-outline-dark" @onclick="OpenShowcasePages">Manage Showcase Pages</button>
        </div>
    </aside>

    <section class="calendar-board">
        <div class="calendar-toolbar">
            <div class="left-tools">
                <button class="btn btn-sm btn-light" @onclick="PrevRange">&lt;</button>
                <button class="btn btn-sm btn-light" @onclick="Today">Today</button>
                <button class="btn btn-sm btn-light" @onclick="NextRange">&gt;</button>
                <span class="range-label">@RangeLabel()</span>
            </div>
            <div class="view-switch">
                @foreach (var option in new[] { "list", "day", "week", "month", "year" })
                {
                    <button class="view-link @(view == option ? "active" : string.Empty)" @onclick='() => SetView(option)'>@option</button>
                }
            </div>
        </div>

        <div class="mb-3 d-flex justify-content-between align-items-center">
            <div>
                <strong>Selected:</strong>
                @if (selectedNodeId.HasValue)
                {
                    <span>@SelectedNodeLabel()</span>
                }
                else
                {
                    <span>All offerings</span>
                }
            </div>
            <div class="text-muted">Showcase pages: @pages.Count</div>
        </div>

        @if (view == "list")
        {
            <div class="list-view">
                @foreach (var item in FilteredOccurrences().OrderBy(x => x.Slots.FirstOrDefault()?.StartUtc))
                {
                    <div class="list-item">
                        <div>
                            <strong>@item.Title</strong>
                            <div class="muted">@item.Description</div>
                            <div class="muted small">@item.RuleGroupName</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="tree-dot" style="background:@item.Color"></span>
                            <span>@item.Slots.Count slot(s)</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="week-head">
                <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
            </div>
            <div class="month-grid">
                @foreach (var day in DaysInView())
                {
                    <div class="day-cell @(day.Date == DateTime.UtcNow.Date ? "today" : string.Empty)">
                        <div class="day-num">@day.Day</div>
                        @foreach (var evt in EventsForDay(day))
                        {
                            <div class="event-chip" style="background:@evt.Color" title="@evt.Label">@evt.Label</div>
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>

@if (showCategoryModal)
{
    <div class="modal-backdrop">
        <div class="booking-modal small-modal">
            <h4>@(editingCategoryId.HasValue ? "Edit Category" : "Add Category")</h4>
            <div class="mb-2">
                <label>Name</label>
                <InputText class="form-control" @bind-Value="categoryRequest.Name" />
            </div>
            <div class="mb-2">
                <label>Parent Category</label>
                <select class="form-select" @bind="categoryRequest.ParentCategoryId">
                    <option value="">(Root)</option>
                    @foreach (var category in categories.Where(x => !editingCategoryId.HasValue || x.Id != editingCategoryId.Value))
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <label>Color</label>
                <InputText class="form-control" @bind-Value="categoryRequest.Color" />
            </div>
            <div class="form-check mb-3">
                <InputCheckbox class="form-check-input" @bind-Value="categoryRequest.IsActive" />
                <label class="form-check-label">Active</label>
            </div>
            <div class="modal-actions">
                @if (editingCategoryId.HasValue)
                {
                    <button class="btn btn-outline-danger" @onclick="DeleteCategory">Delete</button>
                }
                <button class="btn btn-light" @onclick="CloseCategoryModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveCategory">Save</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record TreeRow(string NodeType, int Id, int Level, string Name, string Color);
    private sealed record EventChip(string Label, string Color);

    private CalendarDashboardDto dashboard = new();
    private List<CategoryDto> categories = new();
    private List<ShowcasePageSummaryDto> pages = new();
    private string view = "month";
    private DateTime pivotDate = DateTime.UtcNow.Date;
    private string searchText = string.Empty;
    private int? selectedNodeId;
    private string? selectedNodeType;
    private string? status;
    private bool showCategoryModal;
    private int? editingCategoryId;
    private SaveCategoryRequest categoryRequest = new() { IsActive = true, Color = "#2f80ff" };

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        dashboard = await ApiClient.CalendarDashboardAsync(pivotDate.AddDays(-35), pivotDate.AddDays(35)) ?? new CalendarDashboardDto();
        categories = await ApiClient.CategoriesAsync();
        pages = dashboard.ShowcasePages.ToList();
    }

    private IEnumerable<TreeRow> VisibleRows()
    {
        var categoryLookup = categories.ToLookup(x => x.ParentCategoryId);
        foreach (var row in Walk(null, 0))
        {
            if (string.IsNullOrWhiteSpace(searchText) || row.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            {
                yield return row;
            }
        }

        IEnumerable<TreeRow> Walk(int? parentId, int level)
        {
            foreach (var category in categoryLookup[parentId].OrderBy(x => x.Name))
            {
                yield return new TreeRow("category", category.Id, level, category.Name, category.Color);

                foreach (var child in Walk(category.Id, level + 1))
                {
                    yield return child;
                }

                foreach (var offering in dashboard.Nodes.Where(x => x.NodeType == "offering" && x.ParentCategoryId == category.Id).OrderBy(x => x.Name))
                {
                    yield return new TreeRow("offering", offering.Id, level + 1, offering.Name, offering.Color);
                }
            }

            if (parentId is null)
            {
                foreach (var offering in dashboard.Nodes.Where(x => x.NodeType == "offering" && x.ParentCategoryId is null).OrderBy(x => x.Name))
                {
                    yield return new TreeRow("offering", offering.Id, level, offering.Name, offering.Color);
                }
            }
        }
    }

    private IEnumerable<OccurrenceDto> FilteredOccurrences()
    {
        var occurrences = dashboard.Occurrences;
        if (!selectedNodeId.HasValue || string.IsNullOrWhiteSpace(selectedNodeType))
        {
            return occurrences;
        }

        if (selectedNodeType == "offering")
        {
            return occurrences.Where(x => x.OfferingId == selectedNodeId.Value);
        }

        var categoryIds = DescendantCategoryIds(selectedNodeId.Value).ToHashSet();
        categoryIds.Add(selectedNodeId.Value);
        var offeringIds = dashboard.Nodes
            .Where(x => x.NodeType == "offering" && x.ParentCategoryId.HasValue && categoryIds.Contains(x.ParentCategoryId.Value))
            .Select(x => x.Id)
            .ToHashSet();

        return occurrences.Where(x => x.OfferingId.HasValue && offeringIds.Contains(x.OfferingId.Value));
    }

    private IEnumerable<int> DescendantCategoryIds(int id)
    {
        foreach (var child in categories.Where(x => x.ParentCategoryId == id))
        {
            yield return child.Id;
            foreach (var nested in DescendantCategoryIds(child.Id))
            {
                yield return nested;
            }
        }
    }

    private string SelectedNodeLabel()
    {
        var node = dashboard.Nodes.FirstOrDefault(x => x.Id == selectedNodeId && x.NodeType == selectedNodeType);
        return node?.Name ?? "Selection";
    }

    private IEnumerable<DateTime> DaysInView()
    {
        if (view == "day")
        {
            return new[] { pivotDate };
        }

        if (view == "week")
        {
            var start = pivotDate.AddDays(-(int)pivotDate.DayOfWeek);
            return Enumerable.Range(0, 7).Select(i => start.AddDays(i));
        }

        if (view == "year")
        {
            var start = new DateTime(pivotDate.Year, 1, 1);
            return Enumerable.Range(0, 42).Select(i => start.AddDays(i));
        }

        var first = new DateTime(pivotDate.Year, pivotDate.Month, 1);
        var offset = (int)first.DayOfWeek;
        var startMonth = first.AddDays(-offset);
        return Enumerable.Range(0, 42).Select(i => startMonth.AddDays(i));
    }

    private IEnumerable<EventChip> EventsForDay(DateTime day)
        => FilteredOccurrences()
            .Where(o => o.Slots.Any(s => s.StartUtc.Date == day.Date))
            .Select(o => new EventChip(o.Title, o.Color))
            .Take(3)
            .ToList();

    private void SetView(string nextView) => view = nextView;

    private async Task PrevRange()
    {
        pivotDate = view switch
        {
            "day" => pivotDate.AddDays(-1),
            "week" => pivotDate.AddDays(-7),
            "year" => pivotDate.AddYears(-1),
            _ => pivotDate.AddMonths(-1)
        };

        await ReloadAsync();
    }

    private async Task NextRange()
    {
        pivotDate = view switch
        {
            "day" => pivotDate.AddDays(1),
            "week" => pivotDate.AddDays(7),
            "year" => pivotDate.AddYears(1),
            _ => pivotDate.AddMonths(1)
        };

        await ReloadAsync();
    }

    private async Task Today()
    {
        pivotDate = DateTime.UtcNow.Date;
        await ReloadAsync();
    }

    private string RangeLabel()
        => view switch
        {
            "day" => pivotDate.ToString("MMMM dd, yyyy"),
            "week" => $"{pivotDate:MMM dd} - {pivotDate.AddDays(6):MMM dd, yyyy}",
            "year" => pivotDate.Year.ToString(),
            _ => pivotDate.ToString("MMMM yyyy")
        };

    private void SelectNode(string nodeType, int id)
    {
        selectedNodeType = nodeType;
        selectedNodeId = id;
    }

    private void EditNode(string nodeType, int id)
    {
        if (nodeType == "category")
        {
            var category = categories.First(x => x.Id == id);
            editingCategoryId = id;
            categoryRequest = new SaveCategoryRequest
            {
                Id = id,
                ParentCategoryId = category.ParentCategoryId,
                Name = category.Name,
                Color = category.Color,
                IsActive = category.IsActive
            };
            showCategoryModal = true;
            return;
        }

        NavigationManager.NavigateTo($"/offerings?id={id}");
    }

    private void OpenCategoryModal()
    {
        editingCategoryId = null;
        categoryRequest = new SaveCategoryRequest { IsActive = true, Color = "#2f80ff" };
        showCategoryModal = true;
    }

    private void CloseCategoryModal() => showCategoryModal = false;

    private async Task SaveCategory()
    {
        var saved = await ApiClient.SaveCategoryAsync(categoryRequest);
        status = saved is null ? "Category save failed." : "Category saved.";
        showCategoryModal = saved is null;
        await ReloadAsync();
    }

    private async Task DeleteCategory()
    {
        if (!editingCategoryId.HasValue)
        {
            return;
        }

        status = await ApiClient.DeleteCategoryAsync(editingCategoryId.Value)
            ? "Category deleted."
            : "Category delete failed. Remove child categories and offerings first.";
        showCategoryModal = false;
        await ReloadAsync();
    }

    private void OpenOfferingWizard() => NavigationManager.NavigateTo("/offerings");

    private void OpenShowcasePages() => NavigationManager.NavigateTo("/showcase-pages");
}
