@implements IDisposable
@using System.Text.Json
@using PlaNEvent.Shared.Contracts
@inject ApiClient Api
@inject AgentChatOverlayState OverlayState
@inject IJSRuntime Js
@inject TokenAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject PlaNEvent.Client.Services.DisplaySettingsService DisplaySettings
@inject PlaNEvent.Client.Services.TimeZoneState TimeZoneState

@if (OverlayState.IsOpen)
{
    <div class="agent-chat-overlay" @onclick="CloseIfBackdrop">
        <div class="agent-chat-panel" id="agent-chat-panel" @onclick:stopPropagation>
            <div class="agent-chat-resize-handle" id="agent-chat-resize-handle"></div>
            <div class="agent-chat-header">
                <strong>Sage AI</strong>
                <div class="agent-chat-header-controls">
                    <select class="form-select form-select-sm agent-chat-select" value="@DisplaySettings.Theme" @onchange="OnThemeChanged">
                        <option value="default">Default</option>
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                        <option value="grayscale-light">Grayscale Light</option>
                        <option value="grayscale-dark">Grayscale Dark</option>
                        <option value="colour">Colour</option>
                    </select>
                    <select class="form-select form-select-sm agent-chat-select" value="@DisplaySettings.ScalePercent" @onchange="OnScaleChanged">
                        @foreach (var scaleOption in ScaleOptions)
                        {
                            <option value="@scaleOption">@($"{scaleOption}%")</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearConversation" disabled="@isSending">New Chat</button>
                    <button class="btn btn-sm btn-light" @onclick="Close">Close</button>
                </div>
            </div>

            <div class="agent-chat-body" id="agent-chat-body">
                @if (messages.Count == 0)
                {
                    <div class="agent-chat-starter">
                        <p class="agent-chat-muted">Want to see progress report for</p>
                        <div class="agent-msg-actions starter-actions">
                            @foreach (var action in StarterActions())
                            {
                                <button type="button" class="btn @ActionButtonClass(action) btn-sm" @onclick="() => HandleActionAsync(action)">
                                    @action.Label
                                </button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var item in messages)
                    {
                        <div class="agent-msg @(item.IsUser ? "user" : "agent") @(item.IsThinking ? "is-thinking" : string.Empty) @(item.IsStreaming ? "is-streaming" : string.Empty)">
                            <div class="agent-msg-role">@(item.IsUser ? "You" : "Sage Response")</div>
                            @if (item.IsHtml)
                            {
                                <div class="agent-msg-html @(item.IsStreaming ? "typing-active-html" : string.Empty)">@((MarkupString)item.Text)</div>
                            }
                            else if (item.IsThinking)
                            {
                                <div class="agent-thinking-block" aria-live="polite" aria-label="Sage is thinking">
                                    <div class="agent-thinking-dots">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </div>
                                    <div class="agent-thinking-text">@item.Text</div>
                                </div>
                            }
                            else
                            {
                                <div class="agent-msg-text">@item.Text</div>
                            }

                            @if (item.Actions is { Count: > 0 })
                            {
                                <div class="agent-msg-actions">
                                    @foreach (var action in item.Actions)
                                    {
                                        <button type="button" class="btn @ActionButtonClass(action) btn-sm" @onclick="() => HandleActionAsync(action)">
                                            @action.Label
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <EditForm Model="this" OnValidSubmit="SendAsync">
                <div class="agent-chat-input">
                    <InputText class="form-control" @bind-Value="prompt" placeholder="Ask the agent..." />
                    <button type="submit" class="btn btn-primary" disabled="@isSending">@(isSending ? "Thinking..." : "Send")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (activeVerification is not null)
{
    <div class="agent-chat-overlay verification-overlay" @onclick="CloseVerificationDialog">
        <div class="agent-chat-panel verification-panel" @onclick:stopPropagation>
            <div class="agent-chat-header">
                <strong>@activeVerification.Title</strong>
                <button class="btn btn-sm btn-light" @onclick="CloseVerificationDialog">Close</button>
            </div>
            <div class="agent-chat-body verification-body">
                <p class="agent-chat-muted">@activeVerification.Summary</p>
                <div class="verification-grid">
                    @foreach (var detail in activeVerification.Details)
                    {
                        <div class="verification-item">
                            <div class="verification-label">@detail.Label</div>
                            <div class="verification-value">@detail.Value</div>
                        </div>
                    }
                </div>
            </div>
            <div class="verification-footer">
                <button class="btn btn-outline-secondary" @onclick="CloseVerificationDialog">Close</button>
                <button class="btn btn-primary" @onclick="NavigateFromVerification">@activeVerification.NavigateLabel</button>
            </div>
        </div>
    </div>
}

@code {
    private const string ThinkingPlaceholder = "Sage is thinking...";
    private static readonly int[] ScaleOptions = [75, 80, 85, 90, 95, 100, 105, 110, 115, 120, 125, 130, 135, 140, 145, 150, 155, 160, 165, 170, 175, 180, 185, 190, 195, 200];
    private string HtmlResponseInstruction => $@"<system>
Always respond as a valid formatted HTML fragment suitable for direct rendering in the chat UI.
Return HTML only.
Do not return Markdown.
Do not return plain text outside HTML tags.
Do not include html, head, body, style, or script tags.
Use safe semantic tags such as p, ul, ol, li, strong, em, code, pre, blockquote, a, h3, and h4.
Always try to present lists of results in a formatted HTML grid instead of plain bullet lists.
Use appropriate icons or emojis where they improve scanning and meaning.
Include tasteful inline CSS on the returned HTML elements to make the response visually appealing, polished, and easy to scan.
Prefer clean card, badge, chip, and grid layouts for structured data.
Honor the active app theme by using CSS variables instead of hardcoded colors whenever possible.
Prefer these theme-aware variables in inline styles: var(--sage-surface), var(--sage-surface-muted), var(--sage-border), var(--sage-text), var(--sage-muted), and var(--sage-accent).
Avoid hardcoded white, black, or pale blue panel backgrounds unless there is no better option.
The active client theme right now is '{DisplaySettings.Theme}'.
Keep the inline styling lightweight and chat-friendly.
</system>

";
    private string prompt = string.Empty;
    private bool isSending;
    private bool isStartingDefaultReport;
    private DotNetObjectReference<AgentChatOverlay>? streamReference;
    private bool shouldAutoScroll;
    private AgentChatVerificationDto? activeVerification;

    protected override void OnInitialized()
    {
        OverlayState.Changed += OnOverlayChanged;
    }

    private IReadOnlyList<AgentChatOverlayState.ChatLine> messages => OverlayState.Messages;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (OverlayState.IsOpen)
        {
            await Js.InvokeVoidAsync("planeventAgentChat.initResize", "agent-chat-panel", "agent-chat-resize-handle");
        }

        if (OverlayState.IsOpen && messages.Count == 0 && !isSending && !isStartingDefaultReport)
        {
            isStartingDefaultReport = true;
            _ = InvokeAsync(RunDefaultProgressReportAsync);
        }

        if (shouldAutoScroll)
        {
            shouldAutoScroll = false;
            await Js.InvokeVoidAsync("planeventAgentChat.scrollToBottom", "agent-chat-body");
        }
    }

    private void OnOverlayChanged()
    {
        shouldAutoScroll = true;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Close() => OverlayState.Close();

    private void CloseIfBackdrop()
    {
        if (!isSending)
        {
            OverlayState.Close();
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(prompt) || isSending)
        {
            return;
        }

        var text = prompt.Trim();
        prompt = string.Empty;
        OverlayState.AddMessage(new AgentChatOverlayState.ChatLine(true, text, false));
        OverlayState.BeginAgentMessage();
        OverlayState.SetLastAgentThinking(ThinkingPlaceholder);
        isSending = true;

        try
        {
            streamReference ??= DotNetObjectReference.Create(this);
            var token = await AuthStateProvider.GetTokenAsync();
            await Js.InvokeVoidAsync("planeventAgentChat.stream", "api/agent/chat/stream", token, new AgentChatRequest
            {
                Message = $"{HtmlResponseInstruction}{text}",
                SessionId = OverlayState.SessionId
            }, streamReference);
        }
        catch (Exception ex)
        {
            OverlayState.SetLastAgentMessage($"Error: {ex.Message}", false);
        }
        finally
        {
            isSending = false;
        }
    }

    private void ClearConversation()
    {
        if (!isSending)
        {
            OverlayState.ClearConversation();
            activeVerification = null;
            isStartingDefaultReport = false;
        }
    }

    private async Task OnThemeChanged(ChangeEventArgs args)
    {
        await DisplaySettings.SetThemeAsync(args.Value?.ToString() ?? "default");
    }

    private async Task OnScaleChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var scalePercent))
        {
            await DisplaySettings.SetScalePercentAsync(scalePercent);
        }
    }

    private async Task HandleActionAsync(AgentChatActionDto action)
    {
        if (action.RequiresExecution)
        {
            await ExecuteActionAsync(action, action.Label, "Sage is completing that action...");
            return;
        }

        if (string.Equals(action.ActionType, "show_verification", StringComparison.OrdinalIgnoreCase) && action.Verification is not null)
        {
            activeVerification = action.Verification;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.IsNullOrWhiteSpace(action.NavigateUrl))
        {
            NavigationManager.NavigateTo(action.NavigateUrl, forceLoad: false);
        }
    }

    private void CloseVerificationDialog()
    {
        activeVerification = null;
    }

    private void NavigateFromVerification()
    {
        if (activeVerification is null || string.IsNullOrWhiteSpace(activeVerification.NavigateUrl))
        {
            return;
        }

        var target = activeVerification.NavigateUrl;
        activeVerification = null;
        NavigationManager.NavigateTo(target, forceLoad: false);
    }

    private static string ActionButtonClass(AgentChatActionDto action) => action.Style switch
    {
        "primary" => "btn-primary",
        "outline-primary" => "btn-outline-primary",
        "success" => "btn-success",
        _ => "btn-outline-secondary"
    };

    private IReadOnlyList<AgentChatActionDto> StarterActions()
        => new[]
        {
            ProgressAction("Today", "today"),
            ProgressAction("This Week", "this-week"),
            ProgressAction("Yesterday", "yesterday"),
            ProgressAction("Last Week", "last-week"),
            ProgressAction("This Month", "this-month"),
            ProgressAction("Last Month", "last-month"),
            ProgressAction("Current Year", "current-year"),
            ProgressAction("Last Year", "last-year")
        };

    private AgentChatActionDto ProgressAction(string label, string periodKey)
        => new()
        {
            ActionType = "progress_report",
            EntityType = "goal_progress",
            TemplateKey = periodKey,
            Label = label,
            Description = $"{HtmlResponseInstruction}Prepare a progress report for the selected period '{label}'. Compare actual bookings and sales against the configured Sage goal settings, explain the trend, and recommend what actions should be taken next to meet or improve goals. If the selected period is in the past, explicitly recommend what we should do now in the current day/week/month based on those past trends, and what we should avoid doing.",
            Style = "outline-primary",
            RequiresExecution = true
        };

    private async Task RunDefaultProgressReportAsync()
    {
        try
        {
            await ExecuteActionAsync(ProgressAction("Today", "today"), "Today Progress Report", "Sage is preparing today's progress report...");
        }
        finally
        {
            isStartingDefaultReport = false;
        }
    }

    private async Task ExecuteActionAsync(AgentChatActionDto action, string userLabel, string thinkingText)
    {
        if (isSending)
        {
            return;
        }

        OverlayState.AddMessage(new AgentChatOverlayState.ChatLine(true, userLabel, false));
        OverlayState.BeginAgentMessage();
        OverlayState.SetLastAgentThinking(thinkingText);
        isSending = true;

        try
        {
            var response = await Api.AgentChatActionAsync(new AgentChatActionRequest
            {
                SessionId = OverlayState.SessionId,
                ActionType = action.ActionType,
                EntityType = action.EntityType,
                TemplateKey = action.TemplateKey,
                Label = action.Label,
                SourceMessage = action.Description,
                TimeZoneId = TimeZoneState.SelectedTimeZoneId
            });

            if (response is null)
            {
                OverlayState.SetLastAgentMessage("Action failed.", false);
                return;
            }

            OverlayState.SessionId = response.SessionId;
            OverlayState.SetLastAgentResponse(response);
        }
        catch (Exception ex)
        {
            OverlayState.SetLastAgentMessage($"Error: {ex.Message}", false);
        }
        finally
        {
            isSending = false;
        }
    }

    public void Dispose()
    {
        streamReference?.Dispose();
        OverlayState.Changed -= OnOverlayChanged;
    }

    [JSInvokable]
    public Task OnAgentStreamEvent(string eventName, string payloadJson)
    {
        try
        {
            using var doc = JsonDocument.Parse(payloadJson);
            var root = doc.RootElement;

            if (string.Equals(eventName, "session", StringComparison.OrdinalIgnoreCase))
            {
                if (root.TryGetProperty("sessionId", out var sessionElement) && sessionElement.ValueKind == JsonValueKind.String)
                {
                    OverlayState.SessionId = sessionElement.GetString();
                }

                return InvokeAsync(StateHasChanged);
            }

            if (string.Equals(eventName, "delta", StringComparison.OrdinalIgnoreCase))
            {
                if (root.TryGetProperty("htmlReply", out var htmlDeltaElement) && htmlDeltaElement.ValueKind == JsonValueKind.String)
                {
                    var htmlDelta = htmlDeltaElement.GetString() ?? string.Empty;
                    if (!string.IsNullOrWhiteSpace(htmlDelta))
                    {
                        OverlayState.SetLastAgentHtmlStream(htmlDelta);
                        return InvokeAsync(StateHasChanged);
                    }
                }

                return InvokeAsync(StateHasChanged);
            }

            if (string.Equals(eventName, "complete", StringComparison.OrdinalIgnoreCase))
            {
                var response = JsonSerializer.Deserialize<AgentChatResponse>(payloadJson, new JsonSerializerOptions(JsonSerializerDefaults.Web));
                if (response is not null)
                {
                    OverlayState.SessionId = response.SessionId;
                    OverlayState.SetLastAgentResponse(response);
                }
                return InvokeAsync(StateHasChanged);
            }

            if (string.Equals(eventName, "error", StringComparison.OrdinalIgnoreCase))
            {
                var message = root.TryGetProperty("message", out var messageElement) && messageElement.ValueKind == JsonValueKind.String
                    ? messageElement.GetString() ?? "Streaming error."
                    : "Streaming error.";

                OverlayState.SetLastAgentMessage($"Error: {message}", false);
                return InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            OverlayState.SetLastAgentMessage($"Error: {ex.Message}", false);
        }

        return Task.CompletedTask;
    }

}




